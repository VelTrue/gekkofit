+.index .counts span { background: var(--page-card); border-radius: 14px; padding: 8px 14px; color: var(--page-muted); }
+.index .counts b { color: var(--page-text); font-size: 22px; margin-right: 6px; }
+.index .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }
+.index a.s { display: grid; gap: 6px; padding: 18px 20px; border-radius: 22px; background: var(--page-card); text-decoration: none; min-height: 150px; align-content: start; border: 1px solid transparent; }
+.index a.s:hover { border-color: var(--page-accent); }
+.index a.s b { font-size: 18px; } .index a.s span { color: var(--page-muted); font-size: 14px; }
+.index a.s i { font-style: normal; color: var(--page-accent); font-size: 13px; font-weight: 600; }
+.index a.s em { font-style: normal; font-size: 13px; font-weight: 700; color: #ff7aa8; }
+body[data-page-mode="light"].index a.s em { color: #a3164f; }
+.index a.cta { min-height: 0; background: #b8ff3d; color: #0e1804; }
+.index a.cta span { color: #24360a; opacity: 1; }
+.index .note { background: var(--page-card); border-radius: 18px; padding: 16px 20px; font-size: 14px; color: var(--page-muted); }
+.index .note b { color: var(--page-text); }
+
+@media (max-width: 460px) {
+  body { padding: 20px 8px 48px; }
+  .shot, .device { width: 100%; }
+  .device { padding: 6px; border-radius: 40px; }
+  .screen { width: 100%; border-radius: 34px; }
+}
+@media (prefers-reduced-motion: no-preference) { .shot:target .device { transition: box-shadow .3s; } }
diff --git a/docs/design/cabinet/cabinet.js b/docs/design/cabinet/cabinet.js
